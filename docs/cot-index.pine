// COT Index - Asset Managers and Leveraged Funds (TFF, F+O Combined)
//
// Plots the Briese COT Index (0-100, 3-year min/max normalized) for the
// two TFF speculator categories that matter for equity index futures:
//   - Asset Managers (slow real money - pensions, mutuals, insurance)
//   - Leveraged Funds (hedge funds, CTAs, macro)
//
// Methodology per Briese / CMT Level III:
//   COT Index = 100 * (Current Net - Min over 156w) / (Max - Min over 156w)
//
// AUTO mode maps common ETF/index tickers (SPY, QQQ, IWM, DIA, MDY, VXX)
// to their CFTC codes, then falls back to cot.getCFTCCode() for native
// futures symbols (ES1!, NQ1!, etc.). Or paste a code manually in the
// indicator settings: ES=13874A, NQ=209742, RTY=239742, YM=124603,
// EMD=33874A, VX=1170E1.
//
// Reads as:
//   > 80 = extreme long  (asymmetric reversal risk)
//   < 20 = extreme short (squeeze fuel)
//  20-80 = trade has room (ride with positioning, don't fade)

//@version=6
indicator("COT Index", overlay=false)
import TradingView/LibraryCOT/6 as cot

i_cftcCode  = input.string("AUTO", "CFTC Code", tooltip="AUTO = detect from chart symbol or fall back to index map. Or paste manually: ES=13874A, NQ=209742, RTY=239742, YM=124603, EMD=33874A, VX=1170E1")
i_includeFO = input.bool(true, "Include Options (F+O Combined)")
i_window    = input.int(156, "Lookback weeks", minval=26, maxval=520)

getAutoCode() =>
    sym = syminfo.ticker
    switch
        sym == "SPY" or sym == "SPX" or sym == "ES1!" => "13874A"
        sym == "QQQ" or sym == "NDX" or sym == "NQ1!" => "209742"
        sym == "IWM" or sym == "RUT" or sym == "RTY1!" => "239742"
        sym == "DIA" or sym == "DJI" or sym == "YM1!" => "124603"
        sym == "MDY" or sym == "EMD1!" => "33874A"
        sym == "VXX" or sym == "UVXY" or sym == "VIX" or sym == "VX1!" => "1170E1"
        => cot.getCFTCCode(syminfo.tickerid)

string code = i_cftcCode == "AUTO" ? getAutoCode() : i_cftcCode

am_long  = cot.requestCommitmentOfTraders("Financial", code, i_includeFO, "Asset Manager Positions",   "Long",  "All")
am_short = cot.requestCommitmentOfTraders("Financial", code, i_includeFO, "Asset Manager Positions",   "Short", "All")
lf_long  = cot.requestCommitmentOfTraders("Financial", code, i_includeFO, "Leveraged Funds Positions", "Long",  "All")
lf_short = cot.requestCommitmentOfTraders("Financial", code, i_includeFO, "Leveraged Funds Positions", "Short", "All")

am_net = am_long - am_short
lf_net = lf_long - lf_short

cotIdx(series float src, int win) =>
    mn = ta.lowest(src, win)
    mx = ta.highest(src, win)
    rng = mx - mn
    rng == 0 ? 50.0 : 100.0 * (src - mn) / rng

am_idx = cotIdx(am_net, i_window)
lf_idx = cotIdx(lf_net, i_window)

hline(80, "Long",  color=color.new(color.teal, 50), linestyle=hline.style_dashed)
hline(50, "Mid",   color=color.new(color.gray, 60), linestyle=hline.style_dotted)
hline(20, "Short", color=color.new(color.red,  50), linestyle=hline.style_dashed)

plot(am_idx, "Asset Mgrs", color=color.new(#FFB74D, 0), linewidth=2)
plot(lf_idx, "Lev Funds",  color=color.new(#4DD0E1, 0), linewidth=2)
